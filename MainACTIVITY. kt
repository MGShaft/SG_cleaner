val Bordeaux = Color(0xFF6B1C2A)
val Gold = Color(0xFFD4B96A)
val WhatsAppGreen = Color(0xFF25D366)
val TelegramBlue = Color(0xFF229ED9)

class MainActivity : ComponentActivity() {
    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContent { UltraCleanerApp() }
    }
}

@Composable
fun UltraCleanerApp() {
    var categories by remember { mutableStateOf(mapOf<String, List<File>>()) }
    var scanning by remember { mutableStateOf(false) }
    var totalFreed by remember { mutableStateOf(0L) }

    // Calcul pour graphique
    val whatsappSize = categories["WhatsApp Junk"]?.sumOf { it.length() } ?: 0
    val telegramSize = categories["Telegram Cache"]?.sumOf { it.length() } ?: 0
    val thumbSize = categories["Thumbnails"]?.sumOf { it.length() } ?: 0
    val cacheSize = categories["Cache système"]?.sumOf { it.length() } ?: 0
    val total = whatsappSize + telegramSize + thumbSize + cacheSize

    Column(Modifier.fillMaxSize().background(Color(0xFFF9F6F2)).verticalScroll(rememberScrollState()).padding(16.dp)) {
        // Header
        Box(Modifier.fillMaxWidth().background(Bordeaux, RoundedCornerShape(20.dp)).padding(20.dp)) {
            Column {
                Text("SG CLEANER ULTRA", color = Gold, fontWeight = FontWeight.Black)
                Text("Version 2.0 • Saint Guillaume", color = Color.White)
                Spacer(Modifier.height(8.dp))
                if(total>0) {
                    // Graphique camembert simplifié en barres
                    Text("Répartition mémoire à libérer:", color = Color.White.copy(0.8f))
                    Spacer(Modifier.height(8.dp))
                    if(whatsappSize>0) Bar(WhatsAppGreen, whatsappSize, total, "WhatsApp")
                    if(telegramSize>0) Bar(TelegramBlue, telegramSize, total, "Telegram")
                    if(thumbSize>0) Bar(Gold, thumbSize, total, "Thumbnails")
                    if(cacheSize>0) Bar(Color.Gray, cacheSize, total, "Cache")
                }
            }
        }

        Spacer(Modifier.height(16.dp))
        Button(modifier = Modifier.fillMaxWidth(), colors = ButtonDefaults.buttonColors(Bordeaux),
            onClick = {
                scanning = true
                CoroutineScope(Dispatchers.IO).launch {
                    val res = scanUltra()
                    withContext(Dispatchers.Main){ categories = res; scanning = false }
                }
            }) { Text(if(scanning) "SCAN EN COURS..." else "🔍 SCANNER ULTRA") }

        Spacer(Modifier.height(12.dp))
        categories.forEach { (name, files) ->
            if(files.isNotEmpty()){
                Card(Modifier.fillMaxWidth().padding(vertical=6.dp), colors = CardDefaults.cardColors(Color.White)) {
                    Row(Modifier.padding(12.dp).fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween) {
                        Column {
                            Text(name, fontWeight = FontWeight.Bold, color = Bordeaux)
                            Text("${files.size} fichiers", style = MaterialTheme.typography.bodySmall)
                        }
                        Text("${files.sumOf{it.length()}/1024/1024} Mo", color = Bordeaux, fontWeight = FontWeight.Bold)
                    }
                }
            }
        }

        if(total>0){
            Spacer(Modifier.height(20.dp))
            Button(Modifier.fillMaxWidth().height(60.dp), shape = RoundedCornerShape(16.dp),
                colors = ButtonDefaults.buttonColors(Gold, Bordeaux),
                onClick = {
                    categories.values.flatten().forEach { try{ it.deleteRecursively() }catch(_:Exception){} }
                    totalFreed = total
                    categories = emptyMap()
                }) {
                Text("LIBÉRER ${total/1024/1024} Mo MAINTENANT ✨", fontWeight = FontWeight.ExtraBold)
            }
            if(totalFreed>0) Text("✅ ${totalFreed/1024/1024} Mo libérés !", color = WhatsAppGreen, fontWeight = FontWeight.Bold, modifier = Modifier.padding(top=8.dp))
        }
    }
}

@Composable fun Bar(color: Color, value: Long, total: Long, label: String){
    val pct = if(total==0L) 0f else value.toFloat()/total
    Row(Modifier.fillMaxWidth().padding(vertical=2.dp)) {
        Box(Modifier.width(80.dp)){ Text(label, color=Color.White, style=MaterialTheme.typography.bodySmall) }
        Box(Modifier.fillMaxWidth(pct).height(12.dp).clip(RoundedCornerShape(6.dp)).background(color))
    }
}

fun scanUltra(): Map<String, List<File>> {
    val base = File("/storage/emulated/0")
    val res = mutableMapOf<String, MutableList<File>>(
        "WhatsApp Junk" to mutableListOf(),
        "Telegram Cache" to mutableListOf(),
        "Thumbnails" to mutableListOf(),
        "Cache système" to mutableListOf()
    )
    fun scan(dir: File, depth: Int = 0){
        if(depth>6) return
        try {
            dir.listFiles()?.forEach { f ->
                val p = f.path
                if(f.isDirectory){
                    if(p.contains("WhatsApp/Media/.*Sent".toRegex())) res["WhatsApp Junk"]?.addAll(f.listFiles()?.toList()?:emptyList())
                    if(p.contains(".Statuses")) res["WhatsApp Junk"]?.addAll(f.listFiles()?.toList()?:emptyList())
                    if(p.contains("Telegram/Telegram")) res["Telegram Cache"]?.addAll(f.listFiles()?.toList()?:emptyList())
                    if(p.contains("DCIM/.thumbnails") || p.contains(".thumbnails")) res["Thumbnails"]?.add(f)
                    scan(f, depth+1)
                } else {
                    if(f.extension in listOf("tmp","cache","log")) res["Cache système"]?.add(f)
                }
            }
        } catch(_:Exception){}
    }
    scan(base)
    return res
}
